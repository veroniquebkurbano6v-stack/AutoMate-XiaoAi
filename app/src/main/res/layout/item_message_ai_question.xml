<?xml version="1.0" encoding="utf-8"?>
<!--
  AI 问题卡消息条目布局（仿 Trae Work）
  - 头像在左（与 item_message_ai 一致）
  - 气泡宽度撑满可用空间（maxWidth 320dp）
  - 顶部导航条：左侧问题计数（1/3），右侧上一题/下一题切换按钮
  - 中部单问题展示区（containerQuestion 动态填充当前问题）
  - 底部提交按钮
  - tvWechatBadge：微信来源AI问题卡显示绿色"微信"标识
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start|top"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/textAvatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_ai_avatar_modern"
        android:elevation="2dp"
        android:gravity="center"
        android:text="AI"
        android:textColor="#04121F"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_ai_bubble_modern"
        android:elevation="1dp"
        android:maxWidth="320dp"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <!-- 概述（可选，模型给的引导语） -->
        <TextView
            android:id="@+id/textOverview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#1A1A1A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 顶部导航条：问题计数 + 左右切换 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/textQuestionIndex"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/arrow_up_float"
                android:rotation="-90"
                android:scaleType="centerInside"
                android:contentDescription="上一题" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/arrow_up_float"
                android:rotation="90"
                android:scaleType="centerInside"
                android:contentDescription="下一题" />
        </LinearLayout>

        <!-- 单问题展示区（动态填充当前问题的标题+选项+输入） -->
        <FrameLayout
            android:id="@+id/containerQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 提交按钮 -->
        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="#FF4CAF50"
            android:text="提交"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 微信来源标识：仅微信通道AI问题卡显示 -->
    <TextView
        android:id="@+id/tvWechatBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/bg_wechat_badge"
        android:text="微信"
        android:textColor="#FFFFFF"
        android:textSize="8sp"
        android:visibility="gone" />
</LinearLayout>
